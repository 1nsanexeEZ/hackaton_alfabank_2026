POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# backend/jwt
BACKEND_PORT=8000
JWT_ACCESS_TTL_MINUTES=30
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin-2026!
MINIO_ROOT_USER=alfa_minio_admin
MINIO_ROOT_PASSWORD=SuperSecretMinioPassword_123! 
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=credit-documents
# messaging: kafka (compose) | in_process (local run without a broker) | manual (tests)
MESSAGING_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PARTITIONS=3
# demo data (companies, accounts, products) on startup, idempotent
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo-2026!
# one-click login into demo accounts without a password (POST /auth/demo-login):
# for local checks by experts, turn it off (false) on a public stand
DEMO_LOGIN_ENABLED=true
# port of the site on this machine: http://localhost:8080
HTTP_PORT=8080
# public address of the site: presigned upload/download URLs are signed for it,
# so it must match HTTP_PORT (on the public stand: https://alfa-hack.ru)
MINIO_PUBLIC_ENDPOINT=http://localhost:8080
# applications: signing (EDO) and payout (ABS) through external-mocks (both simulated)
APPLICATIONS_EXTERNAL_MOCKS_URL=http://external-mocks:8100
# --- external-mocks ---
# demo values: small latency, no random 503; raise MOCK_FAILURE_RATE (e.g. 0.1) to test resilience
MOCK_LATENCY_MS_MIN=100
MOCK_LATENCY_MS_MAX=400
MOCK_FAILURE_RATE=0
MOCK_BKI_ALWAYS_FAIL_INNS=7705729405
# --- enrichment ---
ENRICHMENT_MOCKS_BASE_URL=http://external-mocks:8100
ENRICHMENT_SOURCE_TIMEOUT_SECONDS=3
ENRICHMENT_RETRIES=3
# --- key rate ---
# key rate of the Bank of Russia, % per year, while nothing in the key rate history
# (/market/key-rates) is in force: the funding part of the offer rate
# (14.00 — the decision of 23.10.2026, check cbr.ru)
KEY_RATE=14.00
# the key rate the catalog rates are set at: clients get the rate range and the support
# program cap moved by (the key rate in force) - CATALOG_KEY_RATE
CATALOG_KEY_RATE=16.50
# --- smart assistant (module assistant of the backend, docs/ai.md) ---
# The model behind it, any OpenAI-compatible API with an open-weights model:
#   local - Ollama of the `ai` profile (default; without it the assistant answers by templates)
#   api   - an external provider, e.g. OpenRouter: set the URL, the key and the model below
#   off   - templates only
ASSISTANT_LLM_PROVIDER=local
ASSISTANT_LLM_BASE_URL=http://ollama:11434/v1
# never commit a real key: put it into your own .env
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OpenRouter instead of the local model:
# ASSISTANT_LLM_PROVIDER=api
# ASSISTANT_LLM_BASE_URL=https://openrouter.ai/api/v1
# ASSISTANT_LLM_API_KEY=sk-or-...
# ASSISTANT_LLM_MODEL=qwen/qwen-2.5-72b-instruct
ASSISTANT_LLM_TIMEOUT_S=25
ASSISTANT_LLM_CONCURRENCY=1
ASSISTANT_LLM_MAX_QUEUE=4
# local only: more hosts inside the perimeter that serve an open-weights model
ASSISTANT_LLM_EXTRA_ALLOWED_HOSTS=
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
OLLAMA_MEM_LIMIT=4g
