# Copy to .env to override the defaults from docker-compose.yml.
# All values below are local-only demo defaults.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

BACKEND_PORT=8000
JWT_ACCESS_TTL_MINUTES=30

# First admin, created on startup if missing. Log in with it and create roles/accounts via API.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin-2026!
