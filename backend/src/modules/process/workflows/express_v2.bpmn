<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_express_v2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0">
  <bpmn:process id="express_v2" name="Экспресс: без залога, автоматическое решение" isExecutable="true" camunda:versionTag="2">
    <bpmn:startEvent id="start" name="Заявка подана">
      <bpmn:outgoing>Flow_start_start_review</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="start_review" name="Принять в работу">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="start_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_start_review</bpmn:incoming>
      <bpmn:outgoing>Flow_start_review_check_completeness</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="check_completeness" name="Проверить полноту">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="check_completeness" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_review_check_completeness</bpmn:incoming>
      <bpmn:incoming>Flow_wait_client_info_check_completeness</bpmn:incoming>
      <bpmn:outgoing>Flow_check_completeness_gw_complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_complete" name="Заявка полная?" default="Flow_gw_complete_fetch_enrichment">
      <bpmn:incoming>Flow_check_completeness_gw_complete</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_complete_request_info</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_complete_fetch_enrichment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="request_info" name="Запросить данные">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="request_info" />
          <camunda:property name="max_iterations" value="2" />
          <camunda:property name="timeout" value="P5D" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_complete_request_info</bpmn:incoming>
      <bpmn:incoming>Flow_gw_outcome_request_info</bpmn:incoming>
      <bpmn:outgoing>Flow_request_info_wait_client_info</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="wait_client_info" name="Ждём данные от клиента" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="wait_client_info" />
          <camunda:property name="max_iterations" value="2" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_request_info_wait_client_info</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_client_info_check_completeness</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="fetch_enrichment" name="Данные о компании: ЕГРЮЛ, ФНС, БКИ, выписки">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="fetch_enrichment" />
          <camunda:property name="max_iterations" value="3" />
          <camunda:property name="timeout" value="PT5M" />
          <camunda:property name="on_failure" value="manual_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_complete_fetch_enrichment</bpmn:incoming>
      <bpmn:outgoing>Flow_fetch_enrichment_check_stop_factors</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="check_stop_factors" name="Стоп-факторы">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="check_stop_factors" />
          <camunda:property name="max_iterations" value="4" />
          <camunda:property name="timeout" value="PT2M" />
          <camunda:property name="on_failure" value="manual_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_fetch_enrichment_check_stop_factors</bpmn:incoming>
      <bpmn:outgoing>Flow_check_stop_factors_gw_stop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_stop" name="Стоп-фактор?" default="Flow_gw_stop_calculate_score">
      <bpmn:incoming>Flow_check_stop_factors_gw_stop</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_stop_calculate_score</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_stop_gw_outcome</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="calculate_score" name="Скоринг">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="calculate_score" />
          <camunda:property name="max_iterations" value="3" />
          <camunda:property name="timeout" value="PT2M" />
          <camunda:property name="on_failure" value="manual_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_stop_calculate_score</bpmn:incoming>
      <bpmn:outgoing>Flow_calculate_score_make_decision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="make_decision" name="Кредитное решение">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="make_decision" />
          <camunda:property name="max_iterations" value="3" />
          <camunda:property name="timeout" value="PT2M" />
          <camunda:property name="on_failure" value="manual_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_calculate_score_make_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_make_decision_gw_outcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_outcome" name="Решение" default="Flow_gw_outcome_reject">
      <bpmn:incoming>Flow_make_decision_gw_outcome</bpmn:incoming>
      <bpmn:incoming>Flow_record_manual_decision_gw_outcome</bpmn:incoming>
      <bpmn:incoming>Flow_gw_stop_gw_outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_outcome_present_offer</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_outcome_request_info</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_outcome_underwriter_review</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_outcome_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="underwriter_review" name="Проверка андеррайтером" camunda:candidateGroups="underwriter">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="underwriter_review" />
          <camunda:property name="max_iterations" value="3" />
          <camunda:property name="timeout" value="PT8H" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_outcome_underwriter_review</bpmn:incoming>
      <bpmn:outgoing>Flow_underwriter_review_record_manual_decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="record_manual_decision" name="Зафиксировать ручное решение">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="record_manual_decision" />
          <camunda:property name="max_iterations" value="3" />
          <camunda:property name="timeout" value="PT2M" />
          <camunda:property name="on_failure" value="manual_review" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_underwriter_review_record_manual_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_record_manual_decision_gw_outcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="present_offer" name="Показать предложение">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="present_offer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_outcome_present_offer</bpmn:incoming>
      <bpmn:outgoing>Flow_present_offer_wait_offer_answer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="wait_offer_answer" name="Ответ клиента на предложение" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="wait_offer_answer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_present_offer_wait_offer_answer</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_offer_answer_gw_answer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_answer" name="Клиент принял?" default="Flow_gw_answer_end_closed">
      <bpmn:incoming>Flow_wait_offer_answer_gw_answer</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_answer_wait_signature</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_answer_end_closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="wait_signature" name="Подписание (смоделировано)" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="wait_signature" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_answer_wait_signature</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_signature_disburse</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="disburse" name="Выдача (АБС — мок)">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="disburse" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_signature_disburse</bpmn:incoming>
      <bpmn:outgoing>Flow_disburse_end_disbursed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reject" name="Отказ">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="step" value="reject" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_outcome_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_reject_end_rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_disbursed" name="disbursed">
      <bpmn:incoming>Flow_disburse_end_disbursed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_closed" name="closed">
      <bpmn:incoming>Flow_gw_answer_end_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_rejected" name="rejected">
      <bpmn:incoming>Flow_reject_end_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_start_review" sourceRef="start" targetRef="start_review" />
    <bpmn:sequenceFlow id="Flow_start_review_check_completeness" sourceRef="start_review" targetRef="check_completeness" />
    <bpmn:sequenceFlow id="Flow_check_completeness_gw_complete" sourceRef="check_completeness" targetRef="gw_complete" />
    <bpmn:sequenceFlow id="Flow_gw_complete_request_info" sourceRef="gw_complete" targetRef="request_info">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">complete == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_complete_fetch_enrichment" sourceRef="gw_complete" targetRef="fetch_enrichment" />
    <bpmn:sequenceFlow id="Flow_request_info_wait_client_info" sourceRef="request_info" targetRef="wait_client_info" />
    <bpmn:sequenceFlow id="Flow_wait_client_info_check_completeness" sourceRef="wait_client_info" targetRef="check_completeness" />
    <bpmn:sequenceFlow id="Flow_fetch_enrichment_check_stop_factors" sourceRef="fetch_enrichment" targetRef="check_stop_factors" />
    <bpmn:sequenceFlow id="Flow_check_stop_factors_gw_stop" sourceRef="check_stop_factors" targetRef="gw_stop" />
    <bpmn:sequenceFlow id="Flow_gw_stop_calculate_score" sourceRef="gw_stop" targetRef="calculate_score" />
    <bpmn:sequenceFlow id="Flow_gw_stop_gw_outcome" name="да" sourceRef="gw_stop" targetRef="gw_outcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">stopped == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_calculate_score_make_decision" sourceRef="calculate_score" targetRef="make_decision" />
    <bpmn:sequenceFlow id="Flow_make_decision_gw_outcome" sourceRef="make_decision" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="Flow_gw_outcome_present_offer" sourceRef="gw_outcome" targetRef="present_offer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome in ["APPROVE", "COUNTER_OFFER"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_outcome_request_info" sourceRef="gw_outcome" targetRef="request_info">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "REQUEST_INFO"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_outcome_underwriter_review" sourceRef="gw_outcome" targetRef="underwriter_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "MANUAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_outcome_reject" sourceRef="gw_outcome" targetRef="reject" />
    <bpmn:sequenceFlow id="Flow_underwriter_review_record_manual_decision" sourceRef="underwriter_review" targetRef="record_manual_decision" />
    <bpmn:sequenceFlow id="Flow_record_manual_decision_gw_outcome" sourceRef="record_manual_decision" targetRef="gw_outcome" />
    <bpmn:sequenceFlow id="Flow_present_offer_wait_offer_answer" sourceRef="present_offer" targetRef="wait_offer_answer" />
    <bpmn:sequenceFlow id="Flow_wait_offer_answer_gw_answer" sourceRef="wait_offer_answer" targetRef="gw_answer" />
    <bpmn:sequenceFlow id="Flow_gw_answer_wait_signature" sourceRef="gw_answer" targetRef="wait_signature">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">offer_answer == "accepted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_answer_end_closed" sourceRef="gw_answer" targetRef="end_closed" />
    <bpmn:sequenceFlow id="Flow_wait_signature_disburse" sourceRef="wait_signature" targetRef="disburse" />
    <bpmn:sequenceFlow id="Flow_disburse_end_disbursed" sourceRef="disburse" targetRef="end_disbursed" />
    <bpmn:sequenceFlow id="Flow_reject_end_rejected" sourceRef="reject" targetRef="end_rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_express_v2">
    <bpmndi:BPMNPlane id="Plane_express_v2" bpmnElement="express_v2">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="122" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_review_di" bpmnElement="start_review">
        <dc:Bounds x="265" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_completeness_di" bpmnElement="check_completeness">
        <dc:Bounds x="445" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_complete_di" bpmnElement="gw_complete" isMarkerVisible="true">
        <dc:Bounds x="655" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_info_di" bpmnElement="request_info">
        <dc:Bounds x="1825" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_client_info_di" bpmnElement="wait_client_info">
        <dc:Bounds x="2005" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fetch_enrichment_di" bpmnElement="fetch_enrichment">
        <dc:Bounds x="805" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calculate_score_di" bpmnElement="calculate_score">
        <dc:Bounds x="1285" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="make_decision_di" bpmnElement="make_decision">
        <dc:Bounds x="1465" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_outcome_di" bpmnElement="gw_outcome" isMarkerVisible="true">
        <dc:Bounds x="1675" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="underwriter_review_di" bpmnElement="underwriter_review">
        <dc:Bounds x="1825" y="270" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="record_manual_decision_di" bpmnElement="record_manual_decision">
        <dc:Bounds x="2005" y="270" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="present_offer_di" bpmnElement="present_offer">
        <dc:Bounds x="1825" y="420" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_offer_answer_di" bpmnElement="wait_offer_answer">
        <dc:Bounds x="2005" y="420" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_answer_di" bpmnElement="gw_answer" isMarkerVisible="true">
        <dc:Bounds x="2215" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_signature_di" bpmnElement="wait_signature">
        <dc:Bounds x="2365" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="disburse_di" bpmnElement="disburse">
        <dc:Bounds x="2545" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_di" bpmnElement="reject">
        <dc:Bounds x="1825" y="570" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_disbursed_di" bpmnElement="end_disbursed">
        <dc:Bounds x="2762" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_closed_di" bpmnElement="end_closed">
        <dc:Bounds x="2402" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected">
        <dc:Bounds x="2042" y="592" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_stop_factors_di" bpmnElement="check_stop_factors">
        <dc:Bounds x="985" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_stop_di" bpmnElement="gw_stop" isMarkerVisible="true">
        <dc:Bounds x="1165" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_start_review_di" bpmnElement="Flow_start_start_review">
        <di:waypoint x="158" y="160" />
        <di:waypoint x="265" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_start_review_check_completeness_di" bpmnElement="Flow_start_review_check_completeness">
        <di:waypoint x="375" y="160" />
        <di:waypoint x="445" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_check_completeness_gw_complete_di" bpmnElement="Flow_check_completeness_gw_complete">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="655" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_complete_request_info_di" bpmnElement="Flow_gw_complete_request_info">
        <di:waypoint x="705" y="160" />
        <di:waypoint x="1825" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_complete_fetch_enrichment_di" bpmnElement="Flow_gw_complete_fetch_enrichment">
        <di:waypoint x="705" y="160" />
        <di:waypoint x="805" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_request_info_wait_client_info_di" bpmnElement="Flow_request_info_wait_client_info">
        <di:waypoint x="1935" y="160" />
        <di:waypoint x="2005" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_client_info_check_completeness_di" bpmnElement="Flow_wait_client_info_check_completeness">
        <di:waypoint x="2060" y="200" />
        <di:waypoint x="2060" y="270" />
        <di:waypoint x="500" y="270" />
        <di:waypoint x="500" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fetch_enrichment_check_stop_factors_di" bpmnElement="Flow_fetch_enrichment_check_stop_factors">
        <di:waypoint x="915" y="160" />
        <di:waypoint x="985" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_calculate_score_make_decision_di" bpmnElement="Flow_calculate_score_make_decision">
        <di:waypoint x="1395" y="160" />
        <di:waypoint x="1465" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_make_decision_gw_outcome_di" bpmnElement="Flow_make_decision_gw_outcome">
        <di:waypoint x="1575" y="160" />
        <di:waypoint x="1675" y="160" />
      </bpmndi:BPMNEdge>
