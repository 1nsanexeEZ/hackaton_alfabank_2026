# --- external-mocks ---
# Задержка ответа источников, мс (имитация сетевой латентности).
MOCK_LATENCY_MS_MIN=200
MOCK_LATENCY_MS_MAX=1500
# Доля запросов, на которые источник отвечает 503 (ретраи и деградация видны в логах). В тестах — 0.
MOCK_FAILURE_RATE=0.1
# ИНН, по которым БКИ всегда отвечает 503 (сценарий S-6 «Сбой»).
MOCK_BKI_ALWAYS_FAIL_INNS=7705729405
