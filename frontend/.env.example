# Режим рабочего места сотрудников (/admin):
# mock — синтетические данные в браузере; real — вход, пользователи и роли через Identity API,
# обзор, очередь и карточка андеррайтера через API бэк-офиса (редактор продуктов, скоринга и проверка
# по ИНН остаются на моках с пометкой «Демо»). Сайт для клиентов всегда ходит в бэкенд.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Куда dev-сервер проксирует /api: бэкенд, запущенный через uv, — http://localhost:8000;
# стенд из docker compose (бэкенд за nginx) — http://localhost
VITE_API_PROXY_TARGET=http://localhost:8000
