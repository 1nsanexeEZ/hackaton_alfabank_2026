# Префикс API бэкенда: его проксируют dev-сервер и nginx
VITE_API_BASE_URL=/api
# Куда dev-сервер проксирует /api: бэкенд, запущенный через uv, — http://localhost:8000;
# стенд из docker compose (бэкенд за nginx) — http://localhost
VITE_API_PROXY_TARGET=http://localhost:8000
# «Умный помощник» — модуль бэкенда, ходит по той же базе VITE_API_BASE_URL.
# mock — окно помощника отвечает шаблонами в браузере без бэкенда; не задана — бэкенд.
# VITE_ASSISTANT_MODE=mock
