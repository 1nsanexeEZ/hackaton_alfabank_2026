<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="0. Контекст"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Уровень 0. Контекст: кто пользуется системой и с кем она говорит" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Предприниматель&lt;br&gt;руководитель, бухгалтер,&lt;br&gt;представитель по доверенности" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="40" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Сотрудник банка&lt;br&gt;андеррайтер, администратор" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="40" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Любой проверяющий&lt;br&gt;договор по QR" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Кредитный кабинет МСП" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="460" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Сайт и кабинет клиента&lt;/b&gt;&lt;br&gt;подбор, предодобрение, заявка,&lt;br&gt;статус, договор, поддержка" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="400" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Рабочее место сотрудника&lt;/b&gt;&lt;br&gt;очередь, досье, решение,&lt;br&gt;продукты, версии модели и политики" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="400" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Кредитный конвейер&lt;/b&gt;&lt;br&gt;BPMN-маршрут, обогащение, стоп-факторы,&lt;br&gt;две модели, кредитная политика, договор" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="440" width="400" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Умный помощник&lt;/b&gt;&lt;br&gt;чат в кабинете клиента, профиль ai, по желанию" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="410" y="570" width="400" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;LLM с открытыми весами&lt;/b&gt;&lt;br&gt;Ollama (Qwen3-4B) или свой&lt;br&gt;OpenAI-совместимый провайдер" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="740" width="400" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Внешние системы — смоделированы в external-mocks" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="460" height="640" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ЕГРЮЛ / ЕГРИП&lt;/b&gt;&lt;br&gt;статус, руководитель, учредители" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="400" height="58" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ФНС&lt;/b&gt;&lt;br&gt;недоимка, выручка, блокировки, «Прозрачный бизнес»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="222" width="400" height="58" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;БКИ&lt;/b&gt;&lt;br&gt;компания, руководитель, учредитель — с согласия" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="294" width="400" height="58" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;ГИР БО&lt;/b&gt;&lt;br&gt;бухгалтерская отчётность" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="366" width="400" height="58" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Контур&lt;/b&gt;&lt;br&gt;суды, приставы, банкротство" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="438" width="400" height="58" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;115-ФЗ&lt;/b&gt;&lt;br&gt;перечни Росфинмониторинга, МВК, ФРОМУ, ПДЛ, ЗСК" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="510" width="400" height="58" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;АБС банка&lt;/b&gt;&lt;br&gt;обороты, стоп-лист, выдача" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="582" width="400" height="58" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;ЭДО&lt;/b&gt;&lt;br&gt;квитанция подписи" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="654" width="400" height="58" as="geometry"/></mxCell><mxCell id="c20" value="заявка, договор" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="рассмотрение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="/verify/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="655"/><mxPoint x="360" y="655"/><mxPoint x="360" y="215"/></Array></mxGeometry></mxCell><mxCell id="c23" value="данные токеном&lt;br&gt;пользователя" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="605"/><mxPoint x="860" y="490"/></Array></mxGeometry></mxCell><mxCell id="c24" value="/chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="HTTP-адаптеры" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="490"/><mxPoint x="900" y="430"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1. Контейнеры"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Уровень 1. Контейнеры: что запускает docker compose" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Браузер&lt;/b&gt;&lt;br&gt;сайт клиента, /admin, /verify" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;nginx 1.31&lt;/b&gt;&lt;br&gt;:8080 (стенд: :443)&lt;br&gt;статика, /api → backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;Vue 3 + Vite + Tailwind,&lt;br&gt;FSD, статика" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="240" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;backend&lt;/b&gt; · FastAPI · 768 МБ&lt;br&gt;модульный монолит:&lt;br&gt;12 модулей + core&lt;br&gt;миграции Alembic и сид при старте" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="280" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Postgres 16&lt;/b&gt;&lt;br&gt;512 МБ&lt;br&gt;таблицы модулей,&lt;br&gt;outbox, inbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="180" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Kafka 3.8 KRaft&lt;/b&gt;&lt;br&gt;1 ГБ&lt;br&gt;события и команды,&lt;br&gt;DLQ, хранение бессрочно" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="180" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;MinIO&lt;/b&gt; · 512 МБ&lt;br&gt;credit-documents&lt;br&gt;credit-contracts&lt;br&gt;(Object Lock 5 лет)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="220" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;external-mocks&lt;/b&gt; · 192 МБ&lt;br&gt;ЕГРЮЛ, ФНС, БКИ, ГИР БО, Контур,&lt;br&gt;115-ФЗ, ЭДО, АБС — смоделировано" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="300" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Профиль ai — по желанию: docker compose --profile ai up -d" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="980" height="230" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;assistant&lt;/b&gt; · FastAPI · 256 МБ&lt;br&gt;127.0.0.1:8200&lt;br&gt;маршрутизатор, факты, постпроверка" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="100" y="660" width="300" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ollama 0.40&lt;/b&gt; · 4 ГБ&lt;br&gt;Qwen3-4B-Instruct Q4_K_M, CPU&lt;br&gt;том ollama_models" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="280" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;или свой провайдер&lt;/b&gt;&lt;br&gt;AI_BASE_URL · AI_API_KEY · AI_MODEL&lt;br&gt;OpenAI-совместимый API" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="770" width="280" height="50" as="geometry"/></mxCell><mxCell id="c14" value="Память по mem_limit: без ИИ ≈ 2,9 ГБ, с профилем ai ≈ 7,2 ГБ.&lt;br&gt;Healthcheck у каждого сервиса, docker compose up --wait.&lt;br&gt;Боевой стенд: docker-compose.prod.yml — HTTPS, basic auth, 80/443." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="400" height="100" as="geometry"/></mxCell><mxCell id="c15" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="/api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="outbox → топики&lt;br&gt;консьюмеры с inbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="S3 API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="415"/></Array></mxGeometry></mxCell><mxCell id="c21" value="presigned URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c2" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="415"/></Array></mxGeometry></mxCell><mxCell id="c22" value="HTTP-адаптеры" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="280"/><mxPoint x="1080" y="525"/></Array></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="400"/></Array></mxGeometry></mxCell><mxCell id="c24" value="GET /me, /bff/applications" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c11" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="540"/><mxPoint x="960" y="540"/></Array></mxGeometry></mxCell><mxCell id="c25" value="/v1/chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Модули и Kafka"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Уровень 2. Модули backend как ограниченные контексты DDD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Сплошная стрелка — асинхронно через Kafka (команды и события). Пунктир — синхронное чтение через facade.py. Запись в чужой модуль — только командой." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Края: экраны и чтение" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1700" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;bff&lt;/b&gt;&lt;br&gt;ответы под экраны кабинета и бэк-офиса" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="360" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;projector&lt;/b&gt;&lt;br&gt;модели чтения: заявки, очередь, дашборд, метрики" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="400" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Ядро: кредитный конвейер" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1100" height="300" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;applications&lt;/b&gt;&lt;br&gt;CreditApplication — владелец статуса&lt;br&gt;документы, дозапрос, предложение,&lt;br&gt;договор, подпись, выдача" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="250" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;process&lt;/b&gt;&lt;br&gt;движок BPMN, экземпляры,&lt;br&gt;задачи андеррайтера,&lt;br&gt;таймауты и эскалация" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;scoring&lt;/b&gt;&lt;br&gt;PD-модель, ML-модель,&lt;br&gt;хранилище признаков,&lt;br&gt;предскрин, проектная оценка" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;decision&lt;/b&gt;&lt;br&gt;политика policy_v10,&lt;br&gt;решения, предодобрение,&lt;br&gt;версии политики" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="250" height="110" as="geometry"/></mxCell><mxCell id="c11" value="Поддерживающие" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="560" height="300" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;clients&lt;/b&gt;&lt;br&gt;компании, участники, права,&lt;br&gt;доверенности, отчётность" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="240" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;products&lt;/b&gt;&lt;br&gt;каталог, подбор,&lt;br&gt;калькулятор, eligibility" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1470" y="320" width="240" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;enrichment&lt;/b&gt;&lt;br&gt;адаптеры источников, снимок,&lt;br&gt;кассовый разрыв, 115-ФЗ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1210" y="450" width="500" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Общие" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1100" height="140" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;identity&lt;/b&gt;&lt;br&gt;учётки, роли, JWT RS256, согласия" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="320" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;лента, персональные новости, SSE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="660" width="320" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;support&lt;/b&gt;&lt;br&gt;обращения, очередь, переписка" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="660" width="320" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;applications.* · process.events · enrichment.* · scoring.* · decision.* · clients.events · support.events&lt;br&gt;у каждого топика — &amp;lt;topic&amp;gt;.dlq" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="640" width="560" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;core — shared kernel&lt;/b&gt;: Unit of Work, outbox / relay / inbox, DLQ, контракты сообщений (published language), доступ RBAC + ABAC, ошибки, настройки, логи. Не знает модулей (import-linter)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c21" value="команды:&lt;br&gt;StartReview, FetchEnrichment,&lt;br&gt;CheckStopFactors, CalculateScore,&lt;br&gt;MakeDecision, PresentOffer…" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c8" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="600"/><mxPoint x="1300" y="600"/></Array></mxGeometry></mxCell><mxCell id="c22" value="ответы и события клиента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c19" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="790"/><mxPoint x="1750" y="790"/><mxPoint x="1750" y="260"/><mxPoint x="460" y="260"/></Array></mxGeometry></mxCell><mxCell id="c23" value="события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c7" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="590"/><mxPoint x="1250" y="590"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="read API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="снимок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="470"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="300"/><mxPoint x="1330" y="300"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="520"/><mxPoint x="1210" y="520"/></Array></mxGeometry></mxCell><mxCell id="c29" value="факты заявки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="условия продукта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="450"/><mxPoint x="1590" y="450"/></Array></mxGeometry></mxCell><mxCell id="c31" value="Связи: customer — supplier (фасады) · published language (контракты Kafka) · anti-corruption layer (адаптеры источников, mapping помощника) · conformist (projector, notifications)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Слои модуля"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Уровень 3. Устройство модуля: зависимости только внутрь" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;presentation&lt;/b&gt;&lt;br&gt;api (роутеры FastAPI) · schemas (pydantic) · consumers (Kafka) · dependencies (DI)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="820" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;adapters (JWT, argon2, httpx, pyHanko, MinIO) · database (ORM) · repositories · exception_handler" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="740" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;facade.py&lt;/b&gt;&lt;br&gt;Protocol + frozen DTO — всё, что модуль отдаёт соседям" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="140" y="340" width="660" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;application&lt;/b&gt;&lt;br&gt;use_cases (класс на операцию, execute()) · dto · interfaces (Protocol-порты) · UnitOfWork" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="180" y="460" width="580" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;domain&lt;/b&gt;&lt;br&gt;агрегаты, value objects, правила, события, исключения — чистый Python" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="220" y="580" width="500" height="90" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Контракты import-linter (CI)&lt;/b&gt;&lt;br&gt;1. Domain is plain Python: без FastAPI, SQLAlchemy, Pydantic, httpx, брокера&lt;br&gt;2. domain и application не видят infrastructure, presentation, module, seed&lt;br&gt;3. domain не знает application&lt;br&gt;4. infrastructure не знает presentation&lt;br&gt;5. Layered modules: module → presentation → infrastructure → (facade) → application → domain&lt;br&gt;+ по модулю: «читает соседей только через фасад»&lt;br&gt;+ core не знает модулей" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="500" height="260" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Пример: applications&lt;/b&gt;&lt;br&gt;domain/application.py — агрегат CreditApplication, переходы статусов&lt;br&gt;domain/contract_documents.py — УИд, журнал подписания с хеш-цепочкой&lt;br&gt;application/use_cases/contracts.py — SignApplicationUseCase&lt;br&gt;application/interfaces/contracts.py — порты ContractSealer, ContractArchive&lt;br&gt;infrastructure/adapters/contract_sealer.py — pyHanko + демо-УЦ&lt;br&gt;infrastructure/adapters/contract_archive.py — MinIO с Object Lock&lt;br&gt;presentation/api/applications.py — POST /applications/{id}/sign" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="500" height="210" as="geometry"/></mxCell><mxCell id="c13" value="Что это даёт: CreditPolicy.decide — чистая функция (golden-тесты на каждую версию политики); подпись банка — порт, в проде меняется на СКЗИ с ГОСТ; внешние источники — порты, мок и реальный источник взаимозаменяемы." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="1400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. BPMN: путь клиента"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Путь клиента до заявки (to-be, как в develop)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Клиент" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2200" height="230" as="geometry"/></mxCell><mxCell id="c3" value="Банк: предодобрение (clients · decision · scoring)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="2200" height="220" as="geometry"/></mxCell><mxCell id="c4" value="Банк: ветка стартапа" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=34;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="2200" height="260" as="geometry"/></mxCell><mxCell id="c5" value="Клиент&lt;br&gt;на сайте" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="70" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Калькулятор и подбор&lt;br&gt;причины «подходит / нет»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="210" y="160" width="180" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Вошёл?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="155" width="80" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Вход&lt;br&gt;в кабинет" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="100" height="46" as="geometry"/></mxCell><mxCell id="c9" value="Есть бизнес?&lt;br&gt;≥ 6 мес. и&lt;br&gt;годовой отчёт" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="110" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Согласия в профиле&lt;br&gt;ПДн (152-ФЗ ст. 9)&lt;br&gt;КИ компании (218-ФЗ ст. 6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="200" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Персональный калькулятор&lt;br&gt;ставка из предодобрения" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1500" y="160" width="200" height="70" as="geometry"/></mxCell><mxCell id="c12" value="Черновик: продукт, сумма, срок, цель,&lt;br&gt;залог, документы, третьи лица 