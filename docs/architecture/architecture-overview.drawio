mxGeometry></mxCell><mxCell id="c18" value="право sign · пароль (argon2id) · Правила · хеш проекта · хеш условий" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="630" y="608" width="300" height="26" as="geometry"/></mxCell><mxCell id="c19" value="статус SIGNED · журнал client_signed · outbox" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="630" y="658" width="300" height="26" as="geometry"/></mxCell><mxCell id="c20" value="ApplicationSigned" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="720" as="sourcePoint"/><mxPoint x="1380" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="итоговый PDF со штампами" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="770" as="sourcePoint"/><mxPoint x="900" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="CMS: ECDSA P-256 + SHA-256, метка времени RFC 3161 (PAdES B-T)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="910" y="808" width="300" height="26" as="geometry"/></mxCell><mxCell id="c23" value="подписанный PDF" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="870" as="sourcePoint"/><mxPoint x="620" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="put signed · журнал bank_sealed" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="920" as="sourcePoint"/><mxPoint x="1140" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="MarkDisbursed" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="970" as="sourcePoint"/><mxPoint x="620" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="выдача (id заявки — ключ идемпотентности) → DISBURSED" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1020" as="sourcePoint"/><mxPoint x="1600" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Подпись клиента — простая ЭП&lt;/b&gt;&lt;br&gt;ключ — пароль учётной записи (ст. 5 ч. 2)&lt;br&gt;равнозначность — по Правилам электронного взаимодействия (ст. 6 ч. 2)&lt;br&gt;правила определения подписанта и тайна ключа (ст. 9 ч. 2)&lt;br&gt;подписано ровно то, что видел: offer_hash + document_hash" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="160" width="280" height="190" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Подпись банка — усиленная ЭП&lt;/b&gt;&lt;br&gt;4 признака ст. 5 ч. 3: криптопреобразование, подписант,&lt;br&gt;контроль изменений, средство ЭП&lt;br&gt;сертификат юрлица для автоподписи (ст. 14 ч. 3)&lt;br&gt;заменяет печать (ст. 6 ч. 3)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="370" width="280" height="190" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Проверка без входа&lt;/b&gt;&lt;br&gt;GET /contracts/verify/{id} — по QR&lt;br&gt;POST /contracts/verify — загрузка файла:&lt;br&gt;not_in_archive · draft_not_signed · no_signature ·&lt;br&gt;signature_broken · untrusted_certificate&lt;br&gt;журнал: SHA-256 цепочка prev_hash → hash" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="580" width="280" height="190" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;УИд сделки&lt;/b&gt; (218-ФЗ, 758-П прил. 2)&lt;br&gt;UUID без дефисов, веса 1..10 по кругу,&lt;br&gt;сумма mod 16 → контрольный символ" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="790" width="280" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Умный помощник"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Умный помощник: ИИ ничего не решает, только формулирует факты" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Вопрос клиента&lt;br&gt;в кабинете" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="90" height="90" as="geometry"/></mxCell><mxCell id="c3" value="GET /me&lt;br&gt;токеном пользователя&lt;br&gt;право assistant.use" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Маршрутизатор&lt;br&gt;на правилах&lt;br&gt;(intents.py)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="195" width="120" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Отказ по шаблону&lt;br&gt;injection, вне темы,&lt;br&gt;внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="360" width="150" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Факты кодом&lt;br&gt;/bff/applications/{id}, /products&lt;br&gt;только клиентские поля (mapping.py)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="230" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Шаблонный ответ&lt;br&gt;из тех же фактов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="210" width="150" height="70" as="geometry"/></mxCell><mxCell id="c8" value="LLM&lt;br&gt;POST {AI_BASE_URL}/chat/completions&lt;br&gt;temperature 0,1 · ≤ 400 токенов&lt;br&gt;без истории и инструментов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1150" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Постпроверка&lt;br&gt;числа и даты из фактов,&lt;br&gt;без внутренних терминов&lt;br&gt;и обещаний" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="180" width="160" height="130" as="geometry"/></mxCell><mxCell id="c10" value="Ответ модели&lt;br&gt;(проверен)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=3;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1680" y="205" width="110" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Ответ&lt;br&gt;по шаблону" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1690" y="380" width="90" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отказ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="решение / статус /&lt;br&gt;платёж / продукты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="факты в CONTEXT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="прошла" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="не прошла" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="425"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;entryX=0.5;entryY=1;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="520"/><mxPoint x="1735" y="520"/></Array></mxGeometry></mxCell><mxCell id="c22" value="таймаут / занято / недоступна" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="500"/><mxPoint x="1735" y="500"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Настройка провайдера&lt;/b&gt; (любой OpenAI-совместимый API)&lt;br&gt;AI_ENABLED=true&lt;br&gt;AI_BASE_URL — http://ollama:11434/v1 или свой endpoint&lt;br&gt;AI_API_KEY — ключ провайдера (в .env, не в репозиторий)&lt;br&gt;AI_MODEL — модель с открытыми весами&lt;br&gt;Без модели — режим rules: те же факты, шаблоны" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="520" height="170" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Защита&lt;/b&gt;&lt;br&gt;скор, коды причин, БКИ, трасса правил — не попадают в порты помощника&lt;br&gt;текст анкеты — отдельным блоком, очищен и обрезан&lt;br&gt;10 вопросов в минуту, одна генерация за раз, очередь 4&lt;br&gt;в промпт не попадают ФИО, ИНН, название компании (152-ФЗ)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="560" height="170" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Замер 23.10.2026, CPU&lt;/b&gt;&lt;br&gt;Qwen3-4B-Instruct (Apache-2.0): 85 % ответов прошли постпроверку,&lt;br&gt;факты в 98 %, утечек 0, p50 12,5 с, пик RAM 4 ГБ&lt;br&gt;режим rules: 45/45 намерений, p50 4 мс" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
