0" width="160" height="1000" as="geometry"/></mxCell><mxCell id="c8" value="АБС (мок)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="80" width="160" height="1000" as="geometry"/></mxCell><mxCell id="c9" value="«Принять предложение»" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="170" as="sourcePoint"/><mxPoint x="380" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="POST /offer/accept → SIGNING" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="220" as="sourcePoint"/><mxPoint x="620" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="OfferAccepted → wait_signature" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="270" as="sourcePoint"/><mxPoint x="1380" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="GET /contract" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="320" as="sourcePoint"/><mxPoint x="620" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="PDF проекта (fpdf2), SHA-256" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="630" y="358" width="300" height="26" as="geometry"/></mxCell><mxCell id="c14" value="put draft (Object Lock 5 лет)" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="420" as="sourcePoint"/><mxPoint x="1140" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="offer_hash + document.sha256" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="470" as="sourcePoint"/><mxPoint x="380" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="читает проект и Правила, вводит пароль" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="520" as="sourcePoint"/><mxPoint x="380" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="POST /sign: пароль, offer_hash,&lt;br&gt;document_hash, rules_version" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="570" as="sourcePoint"/><mxPoint x="620" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="право sign · пароль (argon2id) · Правила · хеш проекта · хеш условий" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="630" y="608" width="300" height="26" as="geometry"/></mxCell><mxCell id="c19" value="статус SIGNED · журнал client_signed · outbox" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="630" y="658" width="300" height="26" as="geometry"/></mxCell><mxCell id="c20" value="ApplicationSigned" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="720" as="sourcePoint"/><mxPoint x="1380" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="итоговый PDF со штампами" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="770" as="sourcePoint"/><mxPoint x="900" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="CMS: ECDSA P-256 + SHA-256, метка времени RFC 3161 (PAdES B-T)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="910" y="808" width="300" height="26" as="geometry"/></mxCell><mxCell id="c23" value="подписанный PDF" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="870" as="sourcePoint"/><mxPoint x="620" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="put signed · журнал bank_sealed" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="920" as="sourcePoint"/><mxPoint x="1140" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="MarkDisbursed" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="970" as="sourcePoint"/><mxPoint x="620" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="выдача (id заявки — ключ идемпотентности) → DISBURSED" style="rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1020" as="sourcePoint"/><mxPoint x="1600" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Подпись клиента — простая ЭП&lt;/b&gt;&lt;br&gt;ключ — пароль учётной записи (ст. 5 ч. 2)&lt;br&gt;равнозначность — по Правилам электронного взаимодействия (ст. 6 ч. 2)&lt;br&gt;правила определения подписанта и тайна ключа (ст. 9 ч. 2)&lt;br&gt;подписано ровно то, что видел: offer_hash + document_hash" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="160" width="280" height="190" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Подпись банка — усиленная ЭП&lt;/b&gt;&lt;br&gt;4 признака ст. 5 ч. 3: криптопреобразование, подписант,&lt;br&gt;контроль изменений, средство ЭП&lt;br&gt;сертификат юрлица для автоподписи (ст. 14 ч. 3)&lt;br&gt;заменяет печать (ст. 6 ч. 3)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="370" width="280" height="190" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Проверка без входа&lt;/b&gt;&lt;br&gt;GET /contracts/verify/{id} — по QR&lt;br&gt;POST /contracts/verify — загрузка файла:&lt;br&gt;not_in_archive · draft_not_signed · no_signature ·&lt;br&gt;signature_broken · untrusted_certificate&lt;br&gt;журнал: SHA-256 цепочка prev_hash → hash" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="580" width="280" height="190" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;УИд сделки&lt;/b&gt; (218-ФЗ, 758-П прил. 2)&lt;br&gt;UUID без дефисов, веса 1..10 по кругу,&lt;br&gt;сумма mod 16 → контрольный символ" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="790" width="280" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Умный помощник"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Умный помощник: ИИ ничего не решает, только формулирует факты" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Вопрос клиента&lt;br&gt;в кабинете" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="90" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Право assistant.use&lt;br&gt;заявка своей компании (ABAC)&lt;br&gt;10 вопросов в минуту" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="170" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Маршрутизатор&lt;br&gt;на правилах&lt;br&gt;(intents.py)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="195" width="120" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Отказ по шаблону&lt;br&gt;injection, вне темы,&lt;br&gt;внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="360" width="150" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Факты кодом из фасадов&lt;br&gt;decision, applications, products&lt;br&gt;только клиентские поля" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="230" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Шаблонный ответ&lt;br&gt;из тех же фактов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="210" width="150" height="70" as="geometry"/></mxCell><mxCell id="c8" value="LLM&lt;br&gt;POST {ASSISTANT_LLM_BASE_URL}/chat/completions&lt;br&gt;temperature 0,1 · ≤ 400 токенов&lt;br&gt;без истории и инструментов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1150" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Постпроверка&lt;br&gt;числа и даты из фактов,&lt;br&gt;без внутренних терминов&lt;br&gt;и обещаний" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1440" y="180" width="160" height="130" as="geometry"/></mxCell><mxCell id="c10" value="Ответ модели&lt;br&gt;(проверен)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=3;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1680" y="205" width="110" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Ответ&lt;br&gt;по шаблону" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=3;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1690" y="380" width="90" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="отказ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="решение / статус /&lt;br&gt;платёж / продукты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="факты в CONTEXT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="прошла" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="не прошла" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="425"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;entryX=0.5;entryY=1;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="520"/><mxPoint x="1735" y="520"/></Array></mxGeometry></mxCell><mxCell id="c22" value="таймаут / занято / недоступна" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="500"/><mxPoint x="1735" y="500"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Настройка провайдера&lt;/b&gt; (любой OpenAI-совместимый API)&lt;br&gt;ASSISTANT_LLM_PROVIDER — local (Ollama профиля ai) · api (свой провайдер) · off&lt;br&gt;ASSISTANT_LLM_BASE_URL — http://ollama:11434/v1 или https://openrouter.ai/api/v1&lt;br&gt;ASSISTANT_LLM_API_KEY — ключ провайдера (в .env, не в репозиторий)&lt;br&gt;ASSISTANT_LLM_MODEL — модель с открытыми весами&lt;br&gt;Без модели — режим rules: те же факты, шаблоны" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="520" height="170" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Защита&lt;/b&gt;&lt;br&gt;скор, коды причин, БКИ, трасса правил — не попадают в порты помощника&lt;br&gt;текст анкеты — только local, отдельным блоком; во внешний API не уходит&lt;br&gt;10 вопросов в минуту, одна генерация за раз, очередь 4&lt;br&gt;в промпт не попадают ФИО, ИНН, название компании (152-ФЗ)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="560" height="170" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Замер 23.10.2026, CPU&lt;/b&gt;&lt;br&gt;Qwen3-4B-Instruct (Apache-2.0): 85 % ответов прошли постпроверку,&lt;br&gt;факты в 98 %, утечек 0, p50 12,5 с, пик RAM 4 ГБ&lt;br&gt;режим rules: 45/45 намерений и ожидаемых фактов" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1220" y="560" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. Скоринг и решение"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="Скоринг и кредитное решение: от данных о компании до исхода" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell><mxCell id="s2" value="Скоринг отвечает «насколько рискованный заёмщик», решение — «что банк готов дать по этому продукту». Сплошная стрелка — команда или событие через Kafka, пунктир — чтение через фасад. Подробно — docs/scoring-architecture.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1740" height="40" as="geometry"/></mxCell><mxCell id="s3" value="1. enrichment — снимок источников" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="640" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;FetchEnrichment&lt;/b&gt; → источники параллельно, с ретраями&lt;br&gt;&lt;br&gt;• ЕГРЮЛ / ЕГРИП — статус, руководитель, ОКВЭД, сверка&lt;br&gt;• ФНС — недоимка, выручка, блокировки&lt;br&gt;• БКИ компании и руководителя — с согласия&lt;br&gt;• ГИР БО — отчётность, капитал&lt;br&gt;• Контур — суды, приставы, банкротство&lt;br&gt;• 115-ФЗ — перечни РФМ, МВК, ФРОМУ, ПДЛ, ЗСК, лицензии&lt;br&gt;• АБС — обороты в банке, стоп-лист&lt;br&gt;• выписка клиента — прогноз кассового разрыва" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="290" height="300" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;enrichment_snapshots&lt;/b&gt;&lt;br&gt;не ответивший источник — в &lt;i&gt;sources_failed&lt;/i&gt;, это не ошибка: дальше разбирают стоп-факторы и «Данные полные?»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="290" height="110" as="geometry"/></mxCell><mxCell id="s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7" value="Таймаут шага PT5M, сбой → андеррайтер (on_failure=manual_review)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="290" height="120" as="geometry"/></mxCell><mxCell id="s8" value="2. decision — стоп-факторы до модели" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="330" height="330" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;CheckStopFactors&lt;/b&gt; → CreditPolicy.screen&lt;br&gt;115-ФЗ: перечни, ЗСК высокий, лицензия&lt;br&gt;ЕГРЮЛ: ликвидация, банкротство, реорганизация, недостоверность, ОКВЭД 92&lt;br&gt;ФНС, БКИ ≥ 30 / &gt; 90 дней, Контур, ГИР БО, стоп-лист банка, срок работы, предскрин стартапа" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="290" height="170" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;REJECT&lt;/b&gt;&lt;br&gt;без скоринга (S-4 «Закат»)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="135" height="80" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;StopFactorsPassed&lt;/b&gt;&lt;br&gt;→ скоринг" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="575" y="340" width="135" height="80" as="geometry"/></mxCell><mxCell id="s12" value="снимок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="s5" target="s9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="535"/><mxPoint x="385" y="235"/></Array></mxGeometry></mxCell><mxCell id="s13" value="есть" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s14" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s9" target="s11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s15" value="3. scoring — две модели риска" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="690" height="610" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b&gt;Хранилище признаков feature_store_v1&lt;/b&gt;: признаки клиента из снимка ≤ 30 дней (пишется на каждый EnrichmentCompleted) + признаки заявки (сумма, срок, продукт, залог), as_of = дата подачи" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="510" width="650" height="70" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b&gt;PD-модель pd_model_v2&lt;/b&gt; (экспертные скоркарты)&lt;br&gt;сегмент: ЮЛ / ИП / новый клиент (обороты в банке ≥ 6 мес.)&lt;br&gt;12 признаков → бины и WoE → баллы → балл 0–1000&lt;br&gt;калибровка: шансы = odds·2^((балл−score)/pdo) → PD&lt;br&gt;грейд A–J по PD, коды причин, флаги&lt;br&gt;версии админа: pd_model_v2.N" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="320" height="210" as="geometry"/></mxCell><mxCell id="s18" value="&lt;b&gt;ML-модель ml_logreg_v1&lt;/b&gt; (обученная)&lt;br&gt;логистическая регрессия на WoE, 10 признаков&lt;br&gt;та же шкала грейдов A–J → сравнима с PD-моделью&lt;br&gt;нет выручки → не применяется (ml_not_applicable)&lt;br&gt;Gini 0,50 против 0,36 на синтетике&lt;br&gt;обучение — backend/ml/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="750" y="600" width="320" height="210" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b&gt;«Данные полные?» quality_v1&lt;/b&gt;: не ответили ФНС или БКИ, или признаков с данными &amp;lt; 0,7 → quality = degraded. Модели всё равно считаются, решает человек." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="830" width="650" height="70" as="geometry"/></mxCell><mxCell id="s20" value="&lt;b&gt;ScoringResult&lt;/b&gt; (неизменяемый): input_snapshot + sha256, model_version, обе оценки, quality → событие &lt;b&gt;ScoreCalculated&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="920" width="650" height="70" as="geometry"/></mxCell><mxCell id="s21" value="CalculateScore" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s11" target="s16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="642" y="455"/><mxPoint x="745" y="455"/></Array></mxGeometry></mxCell><mxCell id="s22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s16" target="s17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s16" target="s18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s17" target="s19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s18" target="s19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s19" target="s20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s27" value="Повтор по input_snapshot и версии модели — тот же результат бит в бит." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="650" height="60" as="geometry"/></mxCell><mxCell id="s28" value="4. decision — policy_v10, порядок правил" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="360" height="970" as="geometry"/></mxCell><mxCell id="s29" value="&lt;b&gt;1. 115-ФЗ&lt;/b&gt;&lt;br&gt;перечни, ЗСК, лицензия → отказ при любом скоре" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="320" height="64" as="geometry"/></mxCell><mxCell id="s30" value="&lt;b&gt;2. Стоп-факторы&lt;/b&gt;&lt;br&gt;повторно и раньше проверки скоринга" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="226" width="320" height="64" as="geometry"/></mxCell><mxCell id="s31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s29" target="s30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s32" value="&lt;b&gt;3. Нет скоринга&lt;/b&gt;&lt;br&gt;→ андеррайтер" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="302" width="320" height="64" as="geometry"/></mxCell><mxCell id="s33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s30" target="s32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s34" value="&lt;b&gt;4. Дозапрос&lt;/b&gt;&lt;br&gt;revenue_mismatch → выписка за 6 мес., один раз" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="378" width="320" height="64" as="geometry"/></mxCell><mxCell id="s35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s32" target="s34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s36" value="&lt;b&gt;5. Ставка&lt;/b&gt;&lt;br&gt;ключевая + 1,0 + PD×LGD + 2,0 + 3,5, в коридоре продукта" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="454" width="320" height="64" as="geometry"/></mxCell><mxCell id="s37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s34" target="s36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s38" value="&lt;b&gt;6. Лимит&lt;/b&gt;&lt;br&gt;min: продукт, k(грейд)×выручка, обороты, 40 % потока, грейд, группа, LTV" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="530" width="320" height="64" as="geometry"/></mxCell><mxCell id="s39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s36" target="s38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s40" value="&lt;b&gt;7. Маршруты&lt;/b&gt;&lt;br&gt;ПДЛ, ЗСК, группа риска, третьи лица; данные неполные; сумма &gt; автоматики; расхождения" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="606" width="320" height="64" as="geometry"/></mxCell><mxCell id="s41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s38" target="s40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s42" value="&lt;b&gt;8. Мягкие триггеры&lt;/b&gt;&lt;br&gt;недоимка, смена руководителя, разгон оборотов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="682" width="320" height="64" as="geometry"/></mxCell><mxCell id="s43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s40" target="s42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s44" value="&lt;b&gt;9. Матрица грейд × сумма&lt;/b&gt;&lt;br&gt;A–C до 50 млн · D–E 15/50 · F–G 5/20 · H–J —/3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="758" width="320" height="64" as="geometry"/></mxCell><mxCell id="s45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s42" target="s44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s46" value="&lt;b&gt;10. Две модели&lt;/b&gt;&lt;br&gt;зона PD × зона ML: одобрить, проверка, спорная, отказ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="834" width="320" height="64" as="geometry"/></mxCell><mxCell id="s47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s44" target="s46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s48" value="&lt;b&gt;11. Исход&lt;/b&gt;&lt;br&gt;APPROVE / COUNTER_OFFER (срок, потом сумма) / REJECT с альтернативой" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="910" width="320" height="64" as="geometry"/></mxCell><mxCell id="s49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s46" target="s48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s50" value="&lt;b&gt;12. Согласие ИП&lt;/b&gt;&lt;br&gt;ст. 16 152-ФЗ: без согласия неблагоприятный исход — человеку" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="986" width="320" height="64" as="geometry"/></mxCell><mxCell id="s51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s48" target="s50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s52" value="MakeDecision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s20" target="s29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="955"/><mxPoint x="1090" y="182"/></Array></mxGeometry></mxCell><mxCell id="s53" value="5. Исход → process" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;arcSize=3;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1490" y="110" width="290" height="560" as="geometry"/></mxCell><mxCell id="s54" value="&lt;b&gt;APPROVE&lt;/b&gt;&lt;br&gt;на условиях клиента, оффер 7 дней (S-1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1510" y="150" width="250" height="80" as="geometry"/></mxCell><mxCell id="s55" value="&lt;b&gt;COUNTER_OFFER&lt;/b&gt;&lt;br&gt;другой срок или сумма, условия, альтернатива" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1510" y="248" width="250" height="80" as="geometry"/></mxCell><mxCell id="s56" value="&lt;b&gt;REQUEST_INFO&lt;/b&gt;&lt;br&gt;дозапрос выписки (S-5)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1510" y="346" width="250" height="80" as="geometry"/></mxCell><mxCell id="s57" value="&lt;b&gt;MANUAL_REVIEW&lt;/b&gt;&lt;br&gt;check — проверка (S-2, S-7)&lt;br&gt;dispute — спорная (S-3, S-6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1510" y="444" width="250" height="80" as="geometry"/></mxCell><mxCell id="s58" value="&lt;b&gt;REJECT&lt;/b&gt;&lt;br&gt;понятная причина без порогов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1510" y="542" width="250" height="80" as="geometry"/></mxCell><mxCell id="s59" value="&lt;b&gt;Андеррайтер&lt;/b&gt;: видит обе модели, трассу правил, лимиты с binding, разбивку ставки. RecordManualDecision: комментарий, условия в рамках продукта, до 50 млн; override_of на авторешение." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1490" y="690" width="290" height="130" as="geometry"/></mxCell><mxCell id="s60" value="DecisionMade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s50" target="s59"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="1018"/><mxPoint x="1480" y="755"/></Array></mxGeometry></mxCell><mxCell id="s61" value="&lt;b&gt;Предодобрение без заявки&lt;/b&gt;&lt;br&gt;clients.events, ночной пакет, KeyRateChanged → только verified-компания → scoring.estimate (PD-модель без БКИ и выписок) → грейд на ступень осторожнее → лимит ≤ автоматики → 30 дней" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="330" height="150" as="geometry"/></mxCell><mxCell id="s62" value="&lt;b&gt;Ветка стартапа&lt;/b&gt;&lt;br&gt;предскрин учредителя prescreen_v1 (БКИ физлица с согласия) → бизнес-план → проектная оценка project_v1: DSCR ≥ 1,3, свои ≥ 20 %, покрытие ≥ 0,5 → «предодобрено до N» → заявка всегда к андеррайтеру" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="330" height="145" as="geometry"/></mxCell><mxCell id="s63" value="&lt;b&gt;Версии без релиза&lt;/b&gt;&lt;br&gt;Логика — в коде, цифры — в YAML, проверка при старте.&lt;br&gt;Админ: копия → правка → примерка на последних заявках → активация, откат — активировать архивную. pd_model_v2.N и policy_v10.N, активна одна.&lt;br&gt;Аудит: decision_results — policy_version, rule_trace, лимиты, ставка по шагам." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1490" y="840" width="290" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
